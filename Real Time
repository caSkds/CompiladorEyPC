****************************************************
* MODULO REAL TIME INTERRUPT + RANDOM
* MC68HC11 - THRSim11
****************************************************

*-----------------------------------
* REGISTROS
*-----------------------------------

PACTL   EQU $1026
TMSK2   EQU $1024
TFLG2   EQU $1025

*-----------------------------------
* VARIABLES RAM
*-----------------------------------

RTICNT  EQU $0020
RAND1   EQU $0021
RAND2   EQU $0022
RAND3   EQU $0023
RAND4   EQU $0024

* U8-U11 YA EXISTEN EN SU PROYECTO
* U8 = DIGITO 1
* U9 = DIGITO 2
* U10 = DIGITO 3
* U11 = DIGITO 4

****************************************************
* INICIALIZACION RTI
****************************************************

RTI_INIT

        LDAA #%00000111
        STAA PACTL

        CLR RTICNT

        CLI

        RTS

****************************************************
* GENERADOR RANDOM
****************************************************

GENERAR_RANDOM

OTRA_VEZ

************************************
* DIGITO 1
************************************

        LDAA RTICNT
        ADDA #37
        ANDA #$0F

        CMPA #9
        BLS GUARDA1

        SUBA #10

GUARDA1
        STAA U8

************************************
* DIGITO 2
************************************

        LDAA RTICNT
        ADDA #53
        ANDA #$0F

        CMPA #9
        BLS GUARDA2

        SUBA #10

GUARDA2
        STAA U9

************************************
* DIGITO 3
************************************

        LDAA RTICNT
        ADDA #91
        ANDA #$0F

        CMPA #9
        BLS GUARDA3

        SUBA #10

GUARDA3
        STAA U10

************************************
* DIGITO 4
************************************

        LDAA RTICNT
        ADDA #17
        ANDA #$0F

        CMPA #9
        BLS GUARDA4

        SUBA #10

GUARDA4
        STAA U11

****************************************************
* VALIDACIONES
****************************************************

************************************
* EVITAR 0000
************************************

        LDAA U8
        ORAA U9
        ORAA U10
        ORAA U11

        BEQ OTRA_VEZ

************************************
* EVITAR NUMEROS IGUALES
************************************

        LDAA U8
        CMPA U9
        BNE RANDOM_OK

        CMPA U10
        BNE RANDOM_OK

        CMPA U11
        BNE RANDOM_OK

        JMP OTRA_VEZ

RANDOM_OK

        RTS

****************************************************
* ISR RTI
****************************************************

        ORG $F200

RTI_ISR

        INC RTICNT

        RTI

****************************************************
* VECTOR RTI
****************************************************

        ORG $FFF0
        FCB $F2,$00
